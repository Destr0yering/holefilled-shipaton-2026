EXPO_PUBLIC_APP_MODE=demo
# Closed beta defaults: do not enable account creation or purchases until their
# private support, deletion, and store-test workflows are operational.
EXPO_PUBLIC_ENABLE_BETA_AUTH=false
EXPO_PUBLIC_ENABLE_BETA_PURCHASES=false
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AUTH_REDIRECT_URL=holefilled://auth/callback
# Public RevenueCat SDK keys are platform-specific. Never put a RevenueCat secret key here.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
